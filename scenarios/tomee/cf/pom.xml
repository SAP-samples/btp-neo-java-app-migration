<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sap.cloud.sample</groupId>
    <artifactId>persistence-with-ejb</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>

    <description>This sample provides container-managed persistence with EJB.</description>
    <licenses>
        <license>
            <name>SAP DEVELOPER LICENSE AGREEMENT</name>
            <url>https://tools.hana.ondemand.com/developer-license-3_2.txt</url>
        </license>
    </licenses>

    <properties>

        <lib.dir.path>${project.basedir}/src/main/webapp/WEB-INF/lib</lib.dir.path>

        <cf-tomee-bom-version>2.25.0</cf-tomee-bom-version>
        <sdk-modules-bom-version>5.14.0</sdk-modules-bom-version>
        <sap.security.csi-version>1.0.1</sap.security.csi-version>
        <sap.security.csi.jar>com.sap.security.core.server.csi_${sap.security.csi-version}.jar</sap.security.csi.jar>
        <jakarta.persistence-api-version>3.2.0</jakarta.persistence-api-version>
        <maven-war-plugin.version>3.4.0</maven-war-plugin.version>
    </properties>


    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.sap.cloud.sjb.cf</groupId>
                <artifactId>cf-tomee-bom</artifactId>
                <version>${cf-tomee-bom-version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.sap.cloud.sdk</groupId>
                <artifactId>sdk-modules-bom</artifactId>
                <version>${sdk-modules-bom-version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <dependency>
            <groupId>com.sap.cloud.sdk.cloudplatform</groupId>
            <artifactId>scp-cf</artifactId>
        </dependency>

        <!-- Required for compilation and required at runtime (additional web application libraries) -->
        <dependency>
            <groupId>com.sap.security.core.server</groupId>
            <artifactId>csi</artifactId>
            <version>${sap.security.csi-version}</version>
            <scope>system</scope>
            <systemPath>${lib.dir.path}/${sap.security.csi.jar}</systemPath>
        </dependency>

        <dependency>
            <groupId>jakarta.ejb</groupId>
            <artifactId>jakarta.ejb-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>${jakarta.persistence-api-version}</version>
        </dependency>

    </dependencies> 

 <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>${maven-war-plugin.version}</version>
                <configuration>
                    <warName>${project.artifactId}</warName>
                    <webResources>
                        <resource>
                            <directory>${lib.dir.path}</directory>
                            <includes>
                                <include>${sap.security.csi.jar}</include>
                            </includes>
                            <targetPath>WEB-INF/lib</targetPath>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
